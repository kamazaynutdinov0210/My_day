# === Core ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# === Database ===
DATABASE_URL=postgresql://myday:myday@localhost:5432/myday?schema=public

# === Redis / Queues ===
REDIS_URL=redis://localhost:6379

# === Auth / Sessions ===
SESSION_SECRET=replace-with-random-64-char-string
SESSION_COOKIE_NAME=myday_session
SESSION_TTL_SECONDS=2592000
CSRF_SECRET=replace-with-random-32-char-string

# === Default user settings ===
DEFAULT_TIMEZONE=Asia/Tashkent

# === AI Providers (backend-only, never exposed to frontend) ===
AI_DEFAULT_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# === Integrations (OAuth) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# === Email (for reminder/notification delivery) ===
EMAIL_FROM=noreply@myday.local
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# === Rate limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
